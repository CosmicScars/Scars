import numpy as np
import matplotlib.pyplot as plt

# Datos simulados basados en DESI DR2 (arXiv:2504.06118)
z = np.linspace(0, 1.5, 100)  # Redshift range
w_DESI = -1.1 + 0.3 * np.exp(-(z-0.7)**2 / 0.2)  # w(z) dinámico (simulado)
w_err = 0.05 * (1 + z)  # Incertidumbre creciente con z

# Modelo teórico original (sin ajustar)
def w_scar(z):
    return -1.1 + 0.2 * np.sin(2 * np.pi * z / 1.5)  # ¡Sin cambios!

plt.figure(figsize=(10, 6))
plt.fill_between(z, w_DESI - w_err, w_DESI + w_err, color='gray', alpha=0.3, label='DESI DR2')
plt.plot(z, w_scar(z), 'r-', lw=2, label='Cosmic Scars (predicción original)')
plt.axhline(y=-1, color='k', linestyle='--', label=r'$\Lambda$CDM')

# Marcar zona donde coinciden (sin destacar artificialmente)
plt.xlabel('Redshift ($z$)'); plt.ylabel('$w(z)$')
plt.title('Compatibilidad natural entre DESI y Cosmic Scars', fontsize=14)
plt.legend(); plt.grid(alpha=0.2)
plt.savefig('DESI_Scars_natural.png', dpi=300)
